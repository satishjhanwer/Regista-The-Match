        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "possession_id": {
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "type": {
          "const": "carry",
          "default": "carry",
          "type": "string"
        },
        "end_x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "end_y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "distance_m": {
          "minimum": 0,
          "type": "number"
        },
        "duration_s": {
