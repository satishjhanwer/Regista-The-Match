          "minimum": 0,
          "type": "number"
        },
        "elapsed_s": {
          "description": "Monotonic playing time since kickoff incl. stoppage; use for replay ordering",
          "minimum": 0,
          "type": "number"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
