# Copy to .env and fill in ONE provider. Never commit .env.
# Optional: force a provider. Otherwise the first fully configured one below is used, falling back to "none".
# REGISTA_LLM_PROVIDER=foundry|azure_openai|foundry_local|openai_compat|none

# 1. Microsoft Foundry project (submission target). Auth: `az login` locally, managed identity in Azure.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# 2. Azure OpenAI resource. Leave API key empty to use Entra ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=

# 3. Foundry Local (no cloud account; install Foundry Local first, Windows/macOS). Pick a tool-calling capable model.
FOUNDRY_LOCAL_MODEL=

# 4. Any OpenAI-compatible endpoint, e.g. Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.2:3b
#    (3B models suit an 8 GB CPU-only laptop; qwen2.5:7b-instruct is better if you have the RAM)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# Per-call budget in seconds for the Analyst and each Narrator draft (default 20). CPU-only local models need 120-300.
# REGISTA_LLM_TIMEOUT_S=180
