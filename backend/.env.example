# Copy to .env and fill in. Never commit .env.

# Option A (preferred): Microsoft Foundry project. Auth via `az login` locally, managed identity in Azure.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-deployment-name>

# Option B: plain Azure OpenAI resource. Used only when FOUNDRY_PROJECT_ENDPOINT is empty.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
# Optional. Leave unset to use Entra ID (az login / managed identity).
AZURE_OPENAI_API_KEY=
